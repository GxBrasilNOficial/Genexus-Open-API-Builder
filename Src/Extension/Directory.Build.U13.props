<Project>
  <PropertyGroup>
    <GX18U13Path Condition="'$(GX18U13Path)' == ''">C:\GeneXus\Gx18\U13</GX18U13Path>
    <DefineConstants>$(DefineConstants);GX18U13</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetGX)' == 'GX18U13'">
    <Reference Include="Artech.Architecture.BL.Framework">
