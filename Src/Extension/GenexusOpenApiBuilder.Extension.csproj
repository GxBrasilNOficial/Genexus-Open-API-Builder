<Project Sdk="GeneXus.Package.UI.Sdk">
  <Import Project="Version.Shared.props" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <PackageId>GenexusOpenApiBuilder.Extension</PackageId>
    <Authors>Genexus Open API Builder contributors</Authors>
    <Company>GxBrasilNOficial</Company>
    <Description>Genexus Open API Builder - Alpha</Description>
    <AssemblyTitle>Genexus Open API Builder - Alpha</AssemblyTitle>
    <Product>Genexus Open API Builder - Alpha</Product>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>GenexusOpenApiBuilder.Extension</AssemblyName>
    <RootNamespace>GenexusOpenApiBuilder.Extension</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Domain\**\*.cs" LinkBase="Domain" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
